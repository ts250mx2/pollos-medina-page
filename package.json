{
  "name": "pollos-medina-page",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de pedidos de Pollo Medina con panel de administración en Next.js",
  "scripts": {
    "dev": "next dev -p 3033",
    "build": "next build",
    "start": "next start -p 3033",
    "lint": "eslint",
    "db:migrar": "node server/src/db/migrar.js",
    "db:sembrar": "node server/src/db/sembrar.js",
    "db:reiniciar": "node server/src/db/migrar.js --forzar && node server/src/db/sembrar.js",
    "usuario:crear": "node server/src/db/crear-usuario.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^1.1.1",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "typescript": "^5"
  }
}