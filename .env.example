# ──────────────────────────────────────────────
#  Pollo Medina — variables de entorno
#  Copia este archivo como .env y ajusta los valores.
#  NUNCA subas el archivo .env a un repositorio.
# ──────────────────────────────────────────────

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=74.208.192.90
DB_PORT=3306
DB_NAME=BDPollosMedinaMenu
DB_USER=kyk
DB_PASSWORD=cambia-esto
DB_CONNECTION_LIMIT=10

# Sesión del panel de administración
# Genera una cadena larga y aleatoria:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=8h

# Usuario administrador inicial (solo se usa al ejecutar "npm run db:sembrar")
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administrador

# Subida de imágenes
SUBIDA_MAX_MB=5
