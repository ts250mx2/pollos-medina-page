# ──────────────────────────────────────────────
#  Pollo Medina — variables de entorno
#  Copia este archivo como .env y ajusta los valores.
#  NUNCA subas el archivo .env a un repositorio.
# ──────────────────────────────────────────────

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nombre_de_tu_base
DB_USER=tu_usuario_db
DB_PASSWORD=cambia-esto
DB_CONNECTION_LIMIT=10

# Sesión del panel de administración
# Genera una cadena larga y aleatoria:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=8h

# Usuario administrador inicial (solo se usa al ejecutar "npm run db:sembrar")
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administrador

# Subida de imágenes
SUBIDA_MAX_MB=5

# Dashboard Wansoft: sincroniza el día actual al arrancar y cada hora; a las
# 00:30 cierra el día anterior (zona America/Mexico_City).
WANSOFT_AUTO_SYNC=1
WANSOFT_AUTO_SYNC_ON_START=1
WANSOFT_SYNC_TIMEOUT_MS=480000
