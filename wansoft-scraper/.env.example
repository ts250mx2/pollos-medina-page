# ── Wansoft ──
WANSOFT_URL=https://www.wansoft.net/Wansoft.Web/
WANSOFT_USER=tu_usuario_wansoft
WANSOFT_PASS=tu_password

# Perfil de Chrome donde se guarda la sesión (para no repetir el Turnstile).
# Por defecto: wansoft-scraper/.chrome-profile
# WANSOFT_PROFILE_DIR=

# 1 = ver el navegador (necesario la PRIMERA vez para resolver el Turnstile).
HEADFUL=0

# ── Base de datos (la misma del sitio) ──
DB_HOST=127.0.0.1
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_NAME=nombre_de_tu_base
DB_PORT=3306
